{
  "sila_server": {
    "hostname": "127.0.0.1",
    "port": 50052,
    "tls": false,
    "require_client_auth": false,
    "root_certificates": null,
    "certificate_chain": null,
    "private_key": null,
    "options": {},
    "uuid": "c9628684-0eb7-4ee7-b5c4-1b948697fd52",
    "name": "Opentrons OT-2 Simulator",
    "type": "LiquidHandler",
    "description": "Explicit simulator for the independent OT-2 digital-twin connector",
    "version": "0.1.0",
    "vendor_url": "https://opentrons.com/",
    "default_lifetime": 3600.0
  },
  "cloud_server_endpoint": null,
  "discovery": null,
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "simple": {
        "format": "%(asctime)s %(levelname)s %(name)s: %(message)s"
      }
    },
    "handlers": {
      "stderr": {
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stderr",
        "formatter": "simple"
      }
    },
    "root": {
      "level": "INFO",
      "handlers": ["stderr"]
    }
  },
  "use_simulator": true,
  "serial_port": "/dev/ttyAMA0",
  "with_robot_server": false,
  "lock_timeout_s": null,
  "digital_twin_config_path": "config/ot2_dt_simulator_config.json"
}

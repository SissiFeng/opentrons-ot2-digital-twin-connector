  <Command>
    <Identifier>MoveThrough</Identifier>
    <DisplayName>Move Through</DisplayName>
    <Description>
      Move through a sequence of absolute positions in one command.

      Waypoints are queued into the Smoothie's look-ahead planner without a
      position query between them, so consecutive segments blend instead of
      decelerating to a stop at every point. A discrete MoveTo measures
      ~241 ms per short move on the real robot (position read-back 82 ms,
      execution+settle 153 ms, network 5 ms), so a multi-point path such as a
      tip shake runs several times faster batched than as individual MoveTo
      calls — and without the per-point jerk.

      Every waypoint is validated against the axis bounds before any motion
      starts; one bad waypoint rejects the whole batch with nothing moved.
      Plunger axes (B, C) must stay at their current position in every
      waypoint: batched moves skip Opentrons' plunger backlash preload, so
      plunger motion here would silently cost liquid-handling accuracy — use
      MoveTo, Aspirate or Dispense instead.
    </Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Waypoints</Identifier>
      <DisplayName>Waypoints</DisplayName>
      <Description>
        Ordered absolute targets, each with the speed for the
        segment ending at it (mm/sec, 0 = default speed).
      </Description>
      <DataType>
        <Constrained>
          <DataType>
            <List>
              <DataType>
                <Structure>
                  <Element>
                    <Identifier>X</Identifier>
                    <DisplayName>X</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                  <Element>
                    <Identifier>Y</Identifier>
                    <DisplayName>Y</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                  <Element>
                    <Identifier>Z</Identifier>
                    <DisplayName>Z</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                  <Element>
                    <Identifier>A</Identifier>
                    <DisplayName>A</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                  <Element>
                    <Identifier>B</Identifier>
                    <DisplayName>B</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                  <Element>
                    <Identifier>C</Identifier>
                    <DisplayName>C</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                  <Element>
                    <Identifier>Speed</Identifier>
                    <DisplayName>Speed</DisplayName>
                    <Description />
                    <DataType>
                      <Basic>Real</Basic>
                    </DataType>
                  </Element>
                </Structure>
              </DataType>
            </List>
          </DataType>
          <Constraints>
            <MinimalElementCount>1</MinimalElementCount>
          </Constraints>
        </Constrained>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Response0</Identifier>
      <DisplayName>Response 0</DisplayName>
      <Description>The firmware-queried position after the final waypoint.</Description>
      <DataType>
        <Structure>
          <Element>
            <Identifier>X</Identifier>
            <DisplayName>X</DisplayName>
            <Description />
            <DataType>
              <Basic>Real</Basic>
            </DataType>
          </Element>
          <Element>
            <Identifier>Y</Identifier>
            <DisplayName>Y</DisplayName>
            <Description />
            <DataType>
              <Basic>Real</Basic>
            </DataType>
          </Element>
          <Element>
            <Identifier>Z</Identifier>
            <DisplayName>Z</DisplayName>
            <Description />
            <DataType>
              <Basic>Real</Basic>
            </DataType>
          </Element>
          <Element>
            <Identifier>A</Identifier>

  <Command>
    <Identifier>Home</Identifier>
    <DisplayName>Home</DisplayName>
    <Description>
      Home the specified axes.

      Uses the full Opentrons homing sequence including current management,
      unstick moves for plunger axes, and proper X/Y sequencing.
    </Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Axes</Identifier>
      <DisplayName>Axes</DisplayName>
      <Description>
        Axes to home as a string of axis letters, e.g. "XYZABC" for a
        full home or "BC" to home only the plungers. Case-insensitive.
      </Description>
      <DataType>
        <Constrained>
          <DataType>
            <Basic>String</Basic>
          </DataType>
          <Constraints>
            <Pattern>^[XYZABCxyzabc]+$</Pattern>
          </Constraints>
        </Constrained>
      </DataType>
    </Parameter>
    <Response>

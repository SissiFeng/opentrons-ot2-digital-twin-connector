  <DefinedExecutionError>
    <Identifier>OutOfBoundsError</Identifier>
    <DisplayName>Out Of Bounds Error</DisplayName>
    <Description>Requested position exceeds the software travel limit for that axis.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>PlungerAxisNotSupportedError</Identifier>
    <DisplayName>Plunger Axis Not Supported Error</DisplayName>
    <Description>
      A MoveThrough waypoint moves a plunger axis (B or C), which is not supported.

      Batched moves skip Opentrons' plunger backlash preload, which would cost
      liquid-handling accuracy. Send the waypoint's B/C values equal to the
      current position, and use MoveTo / Aspirate / Dispense for plunger motion.
    </Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>TipProbeError</Identifier>
    <DisplayName>Tip Probe Error</DisplayName>
    <Description>Common base class for all non-exit exceptions.</Description>
  </DefinedExecutionError>

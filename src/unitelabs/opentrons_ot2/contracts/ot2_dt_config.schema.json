{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sissifeng/opentrons-ot2-digital-twin-connector/contracts/ot2_dt_config.schema.json",
  "title": "OT-2 Digital Twin Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_revision",
    "deck_definition",
    "calibration_id",
    "calibration_confirmed",
    "deck_bounds",
    "deck_offset",
    "labware",
    "instruments",
    "trash",
    "state_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "config_revision": {
      "type": "string",
      "minLength": 1
    },
    "deck_definition": {
      "type": "string",
      "minLength": 1
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1
    },
    "calibration_confirmed": {
      "type": "boolean"
    },
    "deck_bounds": {
      "$ref": "#/$defs/deck_bounds"
    },
    "deck_offset": {
      "$ref": "#/$defs/point"
    },
    "labware": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/labware"
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/instrument"
      }
    },
    "trash": {
      "$ref": "#/$defs/point"
    },
    "state_path": {
      "type": "string"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "deck_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/point"},
        "maximum": {"$ref": "#/$defs/point"}
      }
    },
    "well_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "columns",
        "first_well",
        "row_spacing",
        "column_spacing",
        "approach_height",
        "working_height"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "columns": {"type": "integer", "minimum": 1},
        "first_well": {"$ref": "#/$defs/point"},
        "row_spacing": {"type": "number", "exclusiveMinimum": 0},
        "column_spacing": {"type": "number", "exclusiveMinimum": 0},
        "approach_height": {"type": "number"},
        "working_height": {"type": "number"}
      }
    },
    "labware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labware_id",
        "definition_uri",
        "definition_hash",
        "slot",
        "origin",
        "grid"
      ],
      "properties": {
        "labware_id": {"type": "string", "minLength": 1},
        "definition_uri": {"type": "string", "minLength": 1},
        "definition_hash": {"type": "string", "minLength": 1},
        "slot": {"type": "string", "minLength": 1},
        "origin": {"$ref": "#/$defs/point"},
        "grid": {"$ref": "#/$defs/well_grid"}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount",
        "aliases",
        "expected_model",
        "name",
        "channels",
        "minimum_volume",
        "maximum_volume",
        "microlitres_per_millimetre",
        "default_aspirate_flow_rate",
        "default_dispense_flow_rate",
        "nozzle_deck_axis_position",
        "safe_travel_height",
        "tip_length",
        "tip_actuation_mode",
        "pickup_presses",
        "pickup_increment",
        "drop_tip_plunger_position"
      ],
      "properties": {
        "mount": {"enum": ["LEFT", "RIGHT"]},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_model": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "channels": {"type": "integer", "minimum": 1},
        "minimum_volume": {"type": "number", "minimum": 0},
        "maximum_volume": {"type": "number", "exclusiveMinimum": 0},
        "microlitres_per_millimetre": {"type": "number", "exclusiveMinimum": 0},
        "default_aspirate_flow_rate": {"type": "number", "exclusiveMinimum": 0},
        "default_dispense_flow_rate": {"type": "number", "exclusiveMinimum": 0},
        "nozzle_deck_axis_position": {"type": "number"},
        "safe_travel_height": {"type": "number"},
        "tip_length": {"type": "number", "exclusiveMinimum": 0},
        "tip_actuation_mode": {"enum": ["HARDWARE_API", "CALIBRATED_PLUNGER"]},
        "pickup_presses": {"type": "integer", "minimum": 1},
        "pickup_increment": {"type": "number", "minimum": 0},
        "drop_tip_plunger_position": {"type": "number"}
      }
    }
  }
}
